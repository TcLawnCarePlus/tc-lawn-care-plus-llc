# Copy to .env for local runs only. Never commit a real .env.
# On Render, set these in the dashboard (Environment), not in the repo.
# DATABASE_URL is provided automatically when a Render Postgres database
# is attached. Leave it unset locally to use the SQLite test file.
# DATABASE_URL=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# DING_TO=
